NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/shakti
# Required in production: a random string of 32+ characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma separated browser origins allowed to call the API (the admin panel)
CORS_ORIGINS=http://localhost:5173
# false = only admins can enroll students
SELF_ENROLLMENT=false
# Admin account created by `npm run seed` (choose your own; weak values are refused in production)
ADMIN_EMAIL=admin@shakti.local
ADMIN_PASSWORD=
# Demo students and sample data: on in development, OFF in production unless you set SEED_DEMO=true on purpose
SEED_DEMO=true

# ---- Video streaming (Google Drive) ----
# Which provider new videos use by default: google-drive | link (more can be added in src/services/providers)
VIDEO_PROVIDER=google-drive
# A Google Cloud *service account* (not an OAuth client secret). Share your Drive video folder with its email as "Viewer".
# Option A (recommended on Cloud Run, store it in Secret Manager): the whole key file as one line of JSON
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: the two fields from the key file (keep "\n" escapes inside the key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Strongly recommended: only videos inside this Drive folder can be registered (and so streamed)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Each playback token handed to a student has at least this many seconds left (default 600)
GOOGLE_PLAYBACK_MIN_TTL=600

# ---- Operations ----
# debug | info | warn | error  (logs are JSON lines; tokens and bodies are never logged)
LOG_LEVEL=info
# off disables rate limiting (tests only)
# RATE_LIMIT=on
# Cloud Run sets PORT itself (8080); only set it for local runs.

# Total size of uploaded images kept in MongoDB (MB). Keeps a free 512 MB Atlas cluster from filling up.
MEDIA_MAX_TOTAL_MB=100
